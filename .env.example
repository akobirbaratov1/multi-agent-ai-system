# ─── Required ───────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Optional: LangSmith Monitoring ─────────────────────
# Get your key at: https://smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=multi-agent-ai-system
LANGCHAIN_TRACING_V2=true

# ─── 2Chat (WhatsApp/SMS) ────────────────────────────────
# Get from https://app.2chat.co → Settings → API
TWOCHAT_API_KEY=your_2chat_api_key_here
TWOCHAT_CHANNEL_ID=your_2chat_channel_id_here

# ─── Telegram Bot ────────────────────────────────────────
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ─── Demo Mode (no API key needed) ──────────────────────
# Set to "true" to run with mock responses (for testing/demo)
DEMO_MODE=false

# ─── App Config ──────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# ─── Agent Config ────────────────────────────────────────
CONFIDENCE_THRESHOLD_HIGH=0.85
CONFIDENCE_THRESHOLD_MEDIUM=0.60
MAX_CONVERSATION_HISTORY=20

# ─── Security ────────────────────────────────────────────
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60
