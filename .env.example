# ─── Required ───────────────────────────────────────────
# Not needed when DEMO_MODE=true.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Demo Mode (no API key needed) ──────────────────────
# "true" runs with deterministic mock responses — useful for local dev,
# demos and CI. Must be false in production.
DEMO_MODE=false

# ─── App Config ──────────────────────────────────────────
# APP_ENV=production enables strict startup validation: the app refuses to
# boot without ADMIN_API_KEY and an explicit CORS origin list.
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
# "json" for structured logs (default in production), "text" for humans.
LOG_FORMAT=text

# Where runtime state (FAISS index, CRM records, metrics) is written.
# DATA_DIR=/var/lib/multi-agent-ai

# ─── Models ──────────────────────────────────────────────
# Change models without touching code.
ROUTER_MODEL=claude-sonnet-4-6
AGENT_MODEL=claude-sonnet-4-6
ANTHROPIC_TIMEOUT=30
ANTHROPIC_MAX_RETRIES=3

# ─── Security ────────────────────────────────────────────
# Shared secret for admin endpoints: knowledge-base writes, the operator
# dashboard, CRM reads and the reporting endpoints. REQUIRED in production;
# when unset those endpoints are open, which is only acceptable locally.
# Generate one with: openssl rand -hex 32
ADMIN_API_KEY=

# Comma-separated allowed browser origins. "*" is rejected in production, and
# credentials are only sent when an explicit list is configured.
CORS_ORIGINS=*

RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60
MAX_MESSAGE_LENGTH=5000

# ─── Agent Config ────────────────────────────────────────
CONFIDENCE_THRESHOLD_HIGH=0.85
CONFIDENCE_THRESHOLD_MEDIUM=0.60
MAX_CONVERSATION_HISTORY=20

# ─── Optional: LangSmith Monitoring ─────────────────────
# Get your key at: https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-ai-system

# ─── 2Chat (WhatsApp/SMS) ────────────────────────────────
# Get from https://app.2chat.co → Settings → API
TWOCHAT_API_KEY=
TWOCHAT_CHANNEL_ID=
# HMAC-SHA256 secret used to verify inbound webhook payloads. Without it the
# /webhook/2chat endpoint is a public, unauthenticated path into the agents.
TWOCHAT_WEBHOOK_SECRET=

# ─── Telegram Bot ────────────────────────────────────────
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
